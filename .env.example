# --- Obligatorias -----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Token con rol de SOLO SELECT sobre la tabla y acceso a todas las filas necesarias.
# No colocar la service-role aquí. Revisar RLS/permisos con el administrador.
SUPABASE_READ_KEY=
# Solo para aplicar. En GitHub debe ser un secret del environment protegido.
SUPABASE_SERVICE_ROLE_KEY=

# --- Opcionales ---------------------------------------------------------------
# TMDB: API Key v3 o "API Read Access Token" v4 (se detecta solo).
TMDB_API_KEY=

# Simulación por defecto. false requiere además confirmación, ticket, respaldo y STEPS explícitos.
DRY_RUN=true
# Pasos a ejecutar, en este orden: adult,size,dead,normalize,enrich,dedupe
STEPS=adult,size,dead,normalize,enrich,dedupe
# Freno de emergencia: aborta si una ejecución fuese a borrar más de este % de la tabla.
MAX_DELETE_RATIO=0.1
# Segundo tope acumulado: se aplica el menor entre ratio y número absoluto.
MAX_DELETE_ROWS=1000

# Requeridos SOLO al aplicar. No incluir claves, URLs firmadas ni datos personales.
# APPLY_CONFIRMATION=APPLY:torrents
# CHANGE_TICKET=CAMBIO-123
# BACKUP_REFERENCE=respaldo-verificado-2026-09-26
# AUDIT_DIR=audit               # JSONL privado; no desactivar en ejecución real
# LOG_SAMPLES=false             # true imprime ejemplos de títulos; revisar privacidad

# TORRENTS_TABLE=torrents
# PAGE_SIZE=1000                # 1..10000; tolera max_rows menor del servidor
# DELETE_CHUNK_SIZE=200         # 1..200 para limitar la longitud de URL
# UPDATE_CONCURRENCY=8          # 1..64
# DB_TIMEOUT_MS=30000           # 1..300000; timeout por petición a Supabase
# DB_READ_RETRIES=3             # 0..10; solo lecturas (no DELETE)

# Cabecera para que el trigger no toque updated_at (requiere sql/002_preserve_updated_at.sql)
# PRESERVE_UPDATED_AT=true
# Informe de salud (conteos antes/después)
# REPORT=true

# Paso 1
# ADULT_EXTRA_KEYWORDS=palabra1,palabra2

# Paso 2
# MIN_MOVIE_MB=150
# MIN_SERIES_MB=30
# SIZE_FILTER_INCLUDE_ZERO=false

# Paso 3
# DEAD_AFTER_DAYS=30

# Paso 4
# FILL_METADATA=true              # quality/codec/hdr_format/channels/release_group desde el título

# Paso 5
# 0 = sin límite de títulos (TMDB, AniList y Kitsu); un valor positivo fija un tope.
# ENRICH_MAX_TITLES=0
# ANILIST_RPM=30
# KITSU_RPM=60
# TMDB_RPM=180
# MATCH_THRESHOLD=0.72
# ENRICH_MIN_SEEDERS=1           # no gastar cuota de API en torrents muertos
# ENRICH_RETRY_BASE_HOURS=24      # backoff: 24h, 48h, 96h… (usa ids_checked_at / ids_attempts)
# ENRICH_RETRY_MAX_DAYS=30
# ENRICH_MAX_MINUTES=45
# ENRICH_LOCAL_PROPAGATION=true   # copiar IDs de torrents homónimos ya identificados

# Paso 6
# DEDUPE_KEEP_PER_LANGUAGE=2    # mínimo 1, nunca cero
# DEDUPE_OTHER_LANGUAGES=keep     # keep por defecto; delete requiere revisión expresa

# DEBUG=1
